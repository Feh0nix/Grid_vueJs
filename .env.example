# ---------------------------------------------------------------------------
# Noovy Grid - variables d'environnement du frontend
# Copier ce fichier en `.env` puis adapter les valeurs.
# Les variables VITE_* sont publiques : jamais de secret ici.
# ---------------------------------------------------------------------------

# Base de l'API fournie par le backend, sans slash final.
VITE_API_URL=http://localhost:3000/api

# true  : donnees de demonstration locales, aucun appel reseau.
# false : appels reels vers VITE_API_URL.
# En production, doit valoir false.
VITE_API_MOCK=true

# Delai maximal d'une requete, en millisecondes.
VITE_API_TIMEOUT=15000
